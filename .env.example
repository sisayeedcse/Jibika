APP_NAME=JIBIKA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jibika.gadgetexa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production Database (MySQL / MariaDB on cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_jibika
DB_USERNAME=cpaneluser_jibika_user
DB_PASSWORD=

# Session and Cache (database driver works without redis/memcached)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue: sync for serverless / shared cPanel hosting without long-running daemons
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@jibika.gadgetexa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Explainable AI Service Configuration
# Allowed providers: 'rules_based', 'development', or external provider
AI_PROVIDER=rules_based
AI_API_KEY=
